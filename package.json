{
  "name": "devops-copilot",
  "version": "0.1.0",
  "description": "Extensible multi-account MCP server for LLM-driven AWS operations",
  "type": "module",
  "main": "dist/core/server.js",
  "bin": {
    "devops-copilot": "dist/core/server.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-md.mjs",
    "start": "node dist/core/server.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "keywords": [
    "mcp",
    "aws",
    "devops",
    "llm",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1152.0",
    "@aws-sdk/client-auto-scaling": "^3.1079.0",
    "@aws-sdk/client-cloudtrail": "^3.1152.0",
    "@aws-sdk/client-cloudwatch": "^3.1079.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1085.0",
    "@aws-sdk/client-cost-explorer": "^3.1085.0",
    "@aws-sdk/client-dynamodb": "^3.1127.0",
    "@aws-sdk/client-ec2": "^3.1149.0",
    "@aws-sdk/client-ecs": "^3.1152.0",
    "@aws-sdk/client-eks": "^3.1152.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1149.0",
    "@aws-sdk/client-iam": "^3.1152.0",
    "@aws-sdk/client-lambda": "^3.1127.0",
    "@aws-sdk/client-rds": "^3.1127.0",
