    "@aws-sdk/client-route-53": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/client-sts": "^3.1085.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@smithy/shared-ini-file-loader": "^4.6.8",
    "jmespath": "^0.16.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jmespath": "^0.15.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
